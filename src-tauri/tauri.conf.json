{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stagger",
  "version": "0.1.2",
  "identifier": "dev.ifeanyi.stagger",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stagger",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NDU2QTI3MkVCMDVDNzUKUldSMVhMQXVKMnBGUi9LQk5TUkN1L3E0cTNiYzJDbHNMZTBxUlVwTFRoLy9NVys1VW1NbGkxRjMK",
      "endpoints": [
        "https://github.com/ifeanyidotdev/Stagger/releases/latest/download/latest.json"
      ]
    }
  }
}
